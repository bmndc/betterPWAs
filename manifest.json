{
	"manifest_version": 3,
	"name": "Better PWAs",
	"version": "1.1.0",
	"description": "Improved installable web apps for selected sites.",
	"icons": {
		"48": "images/icon48.png",
		"128": "images/icon128.png",
		"512": "images/icon512.png"
	},
	"action": {
		"default_icon": {
			"48": "images/iconDisabled48.png"
		},
		"default_title": "Better PWA: No betterment available"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"host_permissions": [
		"*://github.com/*",
		"*://*.github.com/*",
		"*://teams.microsoft.com/*",
		"*://*.teams.microsoft.com/*",
		"*://x.com/*",
		"*://*.x.com/*",
		"*://twitter.com/*",
		"*://*.twitter.com/*"
	],
	"content_scripts": [
		{
			"matches": ["https://www.smh.com.au/*"],
			"js": ["manifests/www.smh.com.au.js", "injectManifest.js"]
		},
		{
			"matches": ["https://app.slack.com/*"],
			"js": ["manifests/app.slack.com.js", "injectManifest.js"]
		},
		{
			"matches": ["https://www.canva.com/*"],
			"js": ["manifests/www.canva.com.js", "injectManifest.js"]
		},
		{
			"matches": ["https://app.notion.com/*"],
			"js": ["manifests/app.notion.com.js", "injectManifest.js"]
		},
		{
			"matches": ["https://claude.ai/*"],
			"js": ["manifests/claude.ai.js", "injectManifest.js"]
		},
		{
			"matches": ["https://discord.com/*"],
			"js": ["manifests/discord.com.js", "injectManifest.js"]
		},
		{
			"matches": [
				"https://outlook.live.com/*",
				"https://outlook.office.com/*"
			],
			"js": ["manifests/outlook.live.com.js", "injectManifest.js"]
		},
		{
			"matches": ["https://teams.microsoft.com/*"],
			"js": ["manifests/teams.microsoft.com.js", "injectManifest.js"]
		},
		{
			"matches": [
				"*://x.com/*",
				"*://*.x.com/*",
				"*://twitter.com/*",
				"*://*.twitter.com/*"
			],
			"js": ["manifests/x.com.js", "injectManifest.js"]
		},
		{
			"matches": ["https://github.com/*"],
			"js": ["manifests/github.com.js", "injectManifest.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["manifests/icons/github-256-maskable.png"],
			"matches": ["https://github.com/*"]
		},
		{
			"resources": [
				"manifests/icons/slack-512.png",
				"manifests/icons/slack-144.png",
				"manifests/icons/slack-512-maskable.png"
			],
			"matches": ["https://app.slack.com/*"]
		},
		{
			"resources": [
				"manifests/icons/www.canva.com/canva-192-maskable.png",
				"manifests/icons/www.canva.com/canva-512-maskable.png"
			],
			"matches": ["https://www.canva.com/*"]
		},
		{
			"resources": [
				"manifests/icons/claude.ai/claude-16-monochrome.png",
				"manifests/icons/claude.ai/claude-32-monochrome.png",
				"manifests/icons/claude.ai/claude-48-monochrome.png",
				"manifests/icons/claude.ai/claude-512-monochrome.png"
			],
			"matches": ["https://claude.ai/*"]
		},
		{
			"resources": [
				"manifests/x.com.json",
				"manifests/icons/x.com/twitter-192.png",
				"manifests/icons/x.com/twitter-512.png",
				"manifests/icons/x.com/twitter-192-maskable.png",
				"manifests/icons/x.com/twitter-512-maskable.png",
				"manifests/icons/x.com/twitter-16-monochrome.png",
				"manifests/icons/x.com/twitter-32-monochrome.png",
				"manifests/icons/x.com/twitter-48-monochrome.png",
				"manifests/icons/x.com/twitter-512-monochrome.png",
				"manifests/icons/x.com/icon-compose.png",
				"manifests/icons/x.com/icon-search-stroke.png",
				"manifests/icons/x.com/icon-notifications-stroke.png",
				"manifests/icons/x.com/icon-messages-stroke.png"
			],
			"matches": ["https://x.com/*"]
		}
	],
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "ruleset_1",
				"enabled": true,
				"path": "rules.json"
			}
		]
	},
	"permissions": [
		"declarativeNetRequest",
		"declarativeNetRequestWithHostAccess"
	]
}
